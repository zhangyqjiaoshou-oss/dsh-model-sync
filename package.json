{
  "name": "@dsh-external/dsh-model-sync",
  "version": "1.0.0",
  "description": "One-click / auto model sync for DeepSeek Harness providers — reconciles stored model lists against each provider's /v1/models endpoint, with a Settings page toggle and conversation-open auto-sync.",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "bin": {
    "dsh-model-sync": "./bin/dsh-model-sync.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangyqjiaoshou-oss/dsh-model-sync.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "model-sync",
    "llm"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc <2",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc <2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
